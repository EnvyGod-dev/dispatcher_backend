{
  "name": "Stratum",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "author": "udval",
  "repository": {
    "type": "git"
  },
  "scripts": {
    "lint": "pnpm dlx @biomejs/biome format ./src --write",
    "dev": "tsx watch src/server.ts",
    "build": "tsx ./build.ts",
    "build:worker": "tsx ./build.worker.ts",
    "start": "node ./dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/libs/database/migrate.ts",
    "db:drop": "drizzle-kit drop",
    "db:pull": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@hono/node-server": "^1.11.1",
    "@hono/sentry": "^1.1.0",
    "@hono/swagger-ui": "^0.2.2",
    "@hono/zod-openapi": "^1.1.2",
    "@hono/zod-validator": "^0.2.1",
    "@redocly/cli": "^2.7.0",
    "@supabase/supabase-js": "^2.43.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.13",
    "big.js": "^7.0.1",
    "check-password-strength": "^3.0.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "firebase-admin": "^13.8.0",
    "generate-password": "^1.7.1",
    "hono": "^4.3.6",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.11.5",
    "postgres": "^3.4.4",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@types/bcrypt": "^6.0.0",
    "@types/big.js": "^6.2.2",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "@vitest/ui": "^1.6.0",
    "drizzle-kit": "^0.21.1",
    "esbuild": "^0.21.2",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0",
    "wrangler": "^4.42.2"
  }
}
